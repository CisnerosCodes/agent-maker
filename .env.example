# --- Security (Sky) --- OAuth2 client-credentials (NOT a static API key). See hl-auth.ts.
HIDDENLAYER_CLIENT_ID=            # event code AITX-2026, get creds from the hackathon link
HIDDENLAYER_CLIENT_SECRET=
HIDDENLAYER_API_URL=https://api.hiddenlayer.ai        # or https://api.eu.hiddenlayer.ai (verified: POST /detection/v1/interactions)
# HIDDENLAYER_AUTH_URL=https://auth.hiddenlayer.ai    # token host (default, verified live)
# HIDDENLAYER_PROJECT_ID=        # OPTIONAL — auto-resolves to the account default-project; only set to override
# HIDDENLAYER_MODEL_TAG=agent-maker-worker            # metadata.model grouping label (REQUIRED field; default is fine)
# HL_FAIL_OPEN=1                 # dev-only: pass on heuristics when the scanner errors (default: fail CLOSED)
# NOTE: the trial-tier default ruleset passes most content (Allow/None). Enable/tune
#       detectors in the HiddenLayer console for HL to flag on its own; until then the
#       heuristic floor (detect.ts) is what catches the demo injection.

# --- Inference ---
NVIDIA_INFERENCE_API_KEY=       # Nemotron via NVIDIA hosted endpoints; key must start with nvapi-
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1  # override for vLLM: http://localhost:8000/v1
FEATHERLESS_API_KEY=            # Featherless AI (OpenAI-compat, hosts Nemotron); hackathon usage tokens
#                                 apply here. When set with no WORKER_BACKEND, workers prefer Featherless.
# FEATHERLESS_API_BASE=https://api.featherless.ai/v1   # override if the endpoint host differs
# WORKER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16   # cheapest Featherless Nemotron (testing default)
#                                                           # demo: nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16
# WORKER_MODEL=nvidia/nemotron-3-super-120b-a12b  # VERIFIED slug (docs.api.nvidia.com). Reasoning is a
#   request param: chat_template_kwargs.enable_thinking (+ low_effort), NOT a system-prompt directive.
#   Confirm live: npm run eval -- --backend nvidia --models nvidia/nemotron-3-super-120b-a12b
# VLLM_ENDPOINT=http://localhost:8000/v1   # ladder goal: self-hosted vLLM

# --- NemoClaw worker spawn (Sky's lane; see specs/security/nemoclaw-spawn.spec.md) ---
# NEMOCLAW_PROVIDER=routed                 # hosted NVIDIA router path (NOT "build" — corrected by spec)
# NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1   # non-interactive onboard (there is no NEMOCLAW_YES)

# --- CEO runtime (troublemaker) ---
ANTHROPIC_API_KEY=
MOM_SLACK_APP_TOKEN=            # xapp-... (Socket Mode: no public URL needed)
MOM_SLACK_BOT_TOKEN=            # xoxb-...

# --- Vault (Adrian) ---
AGENT_EMAIL_DOMAIN=agentcorp.dev
RESEND_API_KEY=
APIFY_TOKEN=                    # coupon: AITX_NVIDIA_CLAW_HACK ($50 credit)
APIFY_ACTOR=                    # e.g. junglee/amazon-crawler — set with APIFY_TOKEN to swap the
#                                sample catalog for a REAL scrape (research card flips to live source)
SHOPIFY_ADMIN_TOKEN=            # from the pre-created dev store; run the builder against it ONCE to verify
SHOPIFY_STORE_URL=             # e.g. https://your-dev-store.myshopify.com (no trailing slash)

# --- Worker execution ---
# SIM_MODE=1                     # force ALL workers to simulation (stage insurance); labeled on dashboard
# WORKER_BACKEND=featherless     # api | nvidia | featherless | cli — brain for worker inference
#                                (auto-detected if unset; Featherless wins auto-detect when its key is present)
# WORKER_MODE=nemoclaw           # nemoclaw (contained) | local (break-glass, UNCONTAINED badge). See spec 6.
# RESEARCH_SOURCE_URL=           # live data source the research agent fetches (default: dummyjson mens-shoes)

# --- Governance (autonomy dial; toggleable live on the dashboard) ---
# AUTONOMY_MODE=supervised       # assisted | supervised (default) | autonomous — approval friction, NOT containment.
#                                Containment + critical-exfil block are always on, never on this dial.

# --- Infra ---
DASHBOARD_PORT=4000
REGISTRY_DIR=./data
