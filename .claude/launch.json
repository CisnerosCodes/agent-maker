{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4000
    },
    {
      "name": "dashboard-alt",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set DASHBOARD_PORT=4123&& npx tsx dashboard/server.ts"],
